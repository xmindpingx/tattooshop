# Generate / render / AI redraw / polling / export / candidates / nolist (~4.5k tokens together).
# 03-generate.js: onGenerate, doTextStencil (outline + AI modes, calls /api/text-job then doAiRedraw),
#                 doRender, doAiRedraw (reads text-prompt-pos/neg when S.hasTextJob is set,
#                   text-tab fields take priority over ai-tab fields when S.hasTextJob && textPos filled),
#                 pollJob, showStencil, doExport, doDestubble, doRelight,
#                 loadCandidates (auto-switches to previews tab),
#                 selectCandidate (switches to ai tab after picking — NOT text tab),
#                 toggleNolist, buildNolist, nolistValue, onSizeChange, setSizeChip
# 07-app.js: handlePhotoFile (sets S.hasPhoto=true, S.hasTextJob=false on upload success),
#            showOverlay/hideOverlay/cancelGen, showToast, init,
#            drag-drop handlers (onDragOver, onDragLeave, onDrop, onFileSelect)
# S.hasTextJob lifecycle: set true in doTextStencil AI mode → cleared by setTextMode('outline')
#   and by handlePhotoFile success (new photo resets context).
# NOTE: setVarCount, setGoal, setAiModel, onLoraChange, syncAiUi are in 02-builders.js / 01-state.js, NOT here.
# Together these two files stay under 8k tokens — safe to edit together in architect mode.
/add public/js/03-generate.js public/js/07-app.js
